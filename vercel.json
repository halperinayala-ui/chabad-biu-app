{
  "crons": [{
    "path": "/api/cron-open-registrations",
    "schedule": "0 0 * * *"
  }],
  "rewrites": [
    {
      "source": "/kaparot",
      "destination": "/api/og-kaparot"
    },
    {
      "source": "/kapparot",
      "destination": "/api/og-kaparot"
    },
    {
      "source": "/events/:id",
      "destination": "/api/og-event?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
